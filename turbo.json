{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/postbuild.cjs",
        "$TURBO_ROOT$/father.config.ts"
      ],
      "outputs": ["lib/**", "es/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
