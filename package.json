{
  "name": "xzy-materials",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "alpha:enter": "changeset pre enter alpha",
    "alpha:exit": "changeset pre exit",
    "build": "turbo run build",
    "changelog": "node ./scripts/run-changelog.cjs",
    "changeset": "changeset",
    "changeset:auto": "node ./scripts/changeset-from-git.cjs",
    "dev": "dumi dev",
    "docs:build": "dumi build",
    "docs:dev": "dumi dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen": "node ./scripts/generators/index.cjs",
    "lint": "eslint . --max-warnings=0",
    "release": "node ./scripts/release.cjs",
    "release:docs": "dumi build && gh-pages -d docs-dist",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "version-packages": "changeset version && pnpm changelog"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@changesets/cli": "^2.27.8",
    "@changesets/git": "^3.0.4",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "^20.11.30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitest/coverage-v8": "2.1.9",
    "@xzy18/config": "workspace:*",
    "antd": "^5.20.0",
    "axe-core": "4.10.2",
    "conventional-changelog-cli": "^5.0.0",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "dumi": "^2.4.14",
    "eslint": "^8.57.1",
    "father": "^4.6.8",
    "gh-pages": "^6.3.0",
    "jsdom": "25.0.1",
    "prettier": "^2.8.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "vitest": "2.1.9"
  },
  "packageManager": "pnpm@9.12.0"
}
