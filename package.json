{
  "name": "xzy-materials",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "dumi dev",
    "docs:dev": "dumi dev",
    "docs:build": "dumi build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "release": "CI=true changeset publish",
    "release:alpha": "CI=true changeset publish --no-git-tag --tag alpha",
    "changelog": "node ./scripts/run-changelog.cjs",
    "version-packages": "changeset version && pnpm changelog",
    "version-and-tag": "changeset version && pnpm changelog && git add .changeset package.json packages/*/package.json packages/*/CHANGELOG.md && git commit -m 'Update versions' && git tag -m 'Release versions' v$(node -e \"console.log(require('./package.json').version)\")",
    "changeset": "changeset",
    "changeset:auto": "node ./scripts/changeset-from-git.cjs",
    "gen": "node ./scripts/generators/index.cjs",
    "deploy": "gh-pages -d docs-dist",
    "docs-build-and-publish": "dumi build && gh-pages -d docs-dist"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@changesets/cli": "^2.27.8",
    "@changesets/git": "^3.0.4",
    "conventional-changelog-cli": "^5.0.0",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "@types/node": "^20.11.30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "antd": "^5.20.0",
    "dumi": "^2.4.14",
    "father": "^4.6.8",
    "gh-pages": "^6.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "eslint": "^8.57.1",
    "prettier": "^2.8.8",
    "@xzy18/config": "workspace:*"
  },
  "packageManager": "pnpm@9.12.0"
}
