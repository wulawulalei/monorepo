{
  "name": "@xzy18/config",
  "version": "0.0.2",
  "private": false,
  "description": "Shared ESLint and Prettier configuration for xzy-materials packages",
  "keywords": [
    "eslint",
    "prettier",
    "config"
  ],
  "bugs": {
    "url": "https://github.com/wulawulalei/monorepo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wulawulalei/monorepo.git",
    "directory": "packages/config"
  },
  "license": "MIT",
  "type": "commonjs",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.mts",
        "default": "./src/index.mjs"
      },
      "require": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      }
    },
    "./eslint": {
      "types": "./src/eslint.d.ts",
      "default": "./src/eslint.js"
    },
    "./prettier": {
      "types": "./src/prettier.d.ts",
      "default": "./src/prettier.js"
    },
    "./package.json": "./package.json"
  },
  "main": "src/index.js",
  "module": "src/index.mjs",
  "types": "src/index.d.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "build": "pnpm exec eslint ./src --max-warnings=0 --no-warn-ignored",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@eslint/js": "^8.57.1",
    "@types/eslint": "^8.56.12",
    "@types/prettier": "^2.7.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@umijs/fabric": "^4.0.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "globals": "^13.24.0",
    "prettier-plugin-organize-imports": "^3.2.4",
    "prettier-plugin-packagejson": "^2.4.3"
  },
  "peerDependencies": {
    "eslint": "^8.57.1",
    "prettier": "^2.8.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
