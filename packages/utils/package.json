{
  "name": "@xzy18/utils",
  "version": "0.0.4",
  "private": false,
  "description": "xzy utilities for React/Antd ecosystem",
  "keywords": [
    "typescript",
    "utilities",
    "xzy-materials"
  ],
  "bugs": {
    "url": "https://github.com/wulawulalei/monorepo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wulawulalei/monorepo.git",
    "directory": "packages/utils"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "commonjs",
  "exports": {
    ".": {
      "import": {
        "types": "./es/index.d.ts",
        "default": "./es/index.js"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "lib/index.js",
  "module": "es/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "dist",
    "es"
  ],
  "scripts": {
    "build": "father build && pnpm exec tsx ../../scripts/postbuild.ts",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "father": "^4.6.8",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
