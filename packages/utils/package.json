{
  "name": "@xzy18/utils",
  "version": "0.0.3",
  "private": false,
  "description": "xzy utilities for React/Antd ecosystem",
  "license": "MIT",
  "sideEffects": false,
  "type": "commonjs",
  "exports": {
    ".": {
      "import": {
        "types": "./es/index.d.ts",
        "default": "./es/index.js"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "lib/index.js",
  "module": "es/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "dist",
    "es"
  ],
  "scripts": {
    "build": "father build && node ../../scripts/postbuild.cjs",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "father": "^4.6.8",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
