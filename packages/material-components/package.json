{
  "name": "@xzy18/material-components",
  "version": "1.0.2-alpha.0",
  "private": false,
  "description": "Unified runtime materials for the xzy-materials ecosystem",
  "license": "MIT",
  "sideEffects": false,
  "type": "commonjs",
  "exports": {
    ".": {
      "import": {
        "types": "./es/index.d.ts",
        "default": "./es/index.js"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "lib/index.js",
  "module": "es/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "dist",
    "es"
  ],
  "scripts": {
    "build": "father build && pnpm exec tsx ../../scripts/postbuild.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@xzy18/components": "workspace:*",
    "@xzy18/hooks": "workspace:*",
    "@xzy18/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "father": "^4.6.8",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "antd": "^5.20.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
